# Copy this file to server/.env

PORT=5000
NODE_ENV=development

# Local development database, started for you by `npm run dev`.
# For MongoDB Atlas, paste your mongodb+srv:// connection string here instead.
MONGODB_URI=mongodb://127.0.0.1:27017/homex

# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The frontend's address. Used for CORS and password reset links.
CLIENT_URL=http://localhost:5173

# The first staff accounts are created from these when the server starts.
ADMIN_EMAIL=admin@homex.test
ADMIN_PASSWORD=
CARE_MANAGER_EMAIL=manager@homex.test
CARE_MANAGER_PASSWORD=

# Password for the demo caregivers added by `npm run seed`.
SEED_PASSWORD=

# Set to true to load the demo data every time the server starts. Nothing is added twice.
SEED_ON_START=

# Optional. Leave SMTP_HOST empty to print emails in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HOMEX <no-reply@homex.local>
