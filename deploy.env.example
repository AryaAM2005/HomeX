# Copy this file to deploy.env. Git ignores that copy.
# Then run `npm run seed:deploy`, and paste the contents into Vercel's Environment Variables.

# From MongoDB Atlas. Add /homex before the ?
MONGODB_URI=

# Generate each of these two with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CRON_SECRET=

ADMIN_EMAIL=admin@homex.test
ADMIN_PASSWORD=
CARE_MANAGER_EMAIL=manager@homex.test
CARE_MANAGER_PASSWORD=

# Password for the demo families and caregivers.
SEED_PASSWORD=
